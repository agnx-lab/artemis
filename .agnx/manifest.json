{
  "id": "artemis",
  "name": "Artemis",
  "version": "0.1.0",
  "description": "Agnx 外置：Artemis —— Google 开源的多模态 Android Agent（FastAPI + Angular 单端口 Web 控制台），本机 8130 端口 Guest 嵌入",
  "engines": {
    "agnx": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "icon": "./.agnx/assets/icon.svg",
  "iconDark": "./.agnx/assets/icon-dark.svg",
  "platforms": {
    "desktop": "supported",
    "web": "supported",
    "mobile": "partial"
  },
  "guest": {
    "kind": "web",
    "auth": "none",
    "preferStrategy": "direct-iframe"
  },
  "sidecar": {
    "supervised": true,
    "ensureTool": ".agnx/tools/ensure-artemis.mjs",
    "stateFile": "artemis.json",
    "defaultPort": 8135,
    "extraPorts": [
      8130
    ],
    "label": "Artemis Web 控制台"
  },
  "contributes": {
    "commands": [
      {
        "id": "artemis.open",
        "title": "Artemis"
      }
    ],
    "panels": [
      {
        "id": "artemis.main",
        "title": "Artemis"
      }
    ]
  }
}